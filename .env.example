# Base URL da enderecos-brasil-api consumida pelo front.
#
# O Vite seleciona o arquivo por ambiente automaticamente:
#   - `react-router dev`   -> .env.development (backend local na porta 3000)
#   - `react-router build` -> .env.production  (backend hospedado)
#
# Para sobrescrever localmente sem versionar, crie um .env.local.
VITE_API_BASE_URL=http://localhost:3000
